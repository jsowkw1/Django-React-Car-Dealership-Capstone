# ---------- Django (backend/.env) ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Express + MongoDB service used by Django
BACKEND_URL=http://localhost:3030
SENTIMENT_ANALYZER_URL=http://localhost:3030
# Shared secret sent as X-API-Key to POST /insert_review (must equal API_KEY below)
EXPRESS_API_KEY=
# Demo accounts created by `python manage.py seed_demo`
DJANGO_SUPERUSER_USERNAME=root
DJANGO_SUPERUSER_PASSWORD=
DEMO_USER_PASSWORD=

# ---------- Express API (express-api/.env) ----------
PORT=3030
# Empty = embedded MongoDB (mongodb-memory-server); or a MongoDB Atlas URI
MONGODB_URI=
MONGODB_DB=dealershipsDB
MONGO_DATA_DIR=
API_KEY=

# ---------- React (Vite) ----------
# The React app calls Django on the same origin (/djangoapp/...). In `npm run dev`
# requests are proxied to http://localhost:8000 (see frontend/vite.config.js).
