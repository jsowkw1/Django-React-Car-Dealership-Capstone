# Port the Express API listens on
PORT=3030
# MongoDB connection string (e.g. MongoDB Atlas). Leave empty to use an embedded MongoDB (mongodb-memory-server).
MONGODB_URI=
MONGODB_DB=dealershipsDB
# Optional folder to persist embedded MongoDB data between restarts
MONGO_DATA_DIR=
# Shared secret required on POST /insert_review (must match Django EXPRESS_API_KEY). Empty = disabled.
API_KEY=
